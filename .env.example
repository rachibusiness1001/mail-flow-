# ─────────────────────────────────────────
# MAILFLOW — Environment Variables
# ─────────────────────────────────────────
# Ye file PRIVATE rakho — kisi ko mat batao
# GitHub pe mat daalna is file ko!

# ─── REQUIRED ───
SECRET_KEY=yahan-kuch-bhi-random-likh-do-jaise-mera-mailflow-2024-secret

# ─── GOOGLE OAUTH (optional — agar Google login chahiye) ───
# Google Cloud Console se lo: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── APP URL (local ke liye ye theek hai) ───
APP_BASE_URL=http://localhost:5000

# ─── DATABASE (abhi SQLite use hoga — PostgreSQL baad mein) ───
# DATABASE_URL=sqlite:///mailflow.db   ← default, kuch karne ki zaroorat nahi
